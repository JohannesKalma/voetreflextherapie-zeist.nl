<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Voetreflextherapie Zeist</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <%- include('partials/mainMenu') %>

  <header>
    <h1>Welkom bij Voetreflextherapie Zeist</h1>
    <p>Ontdek ontspanning en balans met professionele voetreflextherapie.</p>
  </header>

  <main>
    <section>
        <% posts.forEach((item) => { %>
            <%=item.post_id %>: <a href="/<%= item.post_name %>"><%= item.title %></a><br>
        <% }); %>
    </section>
  </main>

  <footer>

<div style="padding-top:20px">
  <%- include('partials/footerMenu') %>
</div>  
    <p>© <%= new Date().getFullYear() %> Voetreflextherapie Zeist</p>
  </footer>
</body>
</html>
