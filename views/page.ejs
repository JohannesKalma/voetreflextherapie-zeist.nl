<%- include('partials/header') %>

  <main class="post">

    <article>
      <h1><%= page.title %></h1>
      <section class="content">
        <%- page.content %>
      </section>
    </article>

    <p class="meta">
      <% if (page.date) { %><span>
          <%= page.date %>
        </span>
        <% } %>
    </p>
  </main>

  <%- include('partials/footer') %>