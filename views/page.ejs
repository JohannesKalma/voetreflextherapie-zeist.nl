<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= page.title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

   <%- include('partials/mainMenu') %>


  <main class="post">
    <article>
      <header>
        <h1><%= page.title %></h1>
        <% if (page.subtitle) { %>
          <p class="subtitle"><%= page.subtitle %></p>
        <% } %>
        <p class="meta">
          <% if (page.author) { %><span>By <%= page.author %></span><% } %>
          <% if (page.date) { %><span><%= page.date %></span><% } %>
        </p>
      </header>

      <section class="content">
        <%- page.content %>
      </section>
    </article>

  </main>
  <footer>

<div style="padding-top:20px">
  <%- include('partials/footerMenu') %>
</div>  
    <p>© <%= new Date().getFullYear() %> Voetreflextherapie Zeist</p>
  </footer>
</body>
</html>
